generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// An Operator is a paying user of the SaaS — a "would-be agency owner" who
// signed up to find local businesses, build them websites, and pitch them as
// paying clients. Each Operator owns 0..N Restaurants (their clients).
//
// Roles in the system:
//   - super_admin / platform_admin: Josh, the platform owner. Sees everything.
//   - operator: a paying user. Sees only their own clients/leads.
//   - restaurant_admin: an end-client's owner. Sees only their restaurant.
model Operator {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  // The operator's own agency/brand name (e.g. "Acme Web Studio")
  businessName String?

  // Location context — used as the default for lead search radius
  areaCity     String?
  areaState    String?

  // Subscription state (drives feature gates + billing UI)
  // trial | active | past_due | canceled | incomplete
  subscriptionStatus            String    @default("trial")
  // starter | pro | agency
  subscriptionTier              String    @default("starter")
  trialEndsAt                   DateTime?
  subscriptionCurrentPeriodEnd  DateTime?
  subscriptionCanceledAt        DateTime?
  // Set when cancel_at_period_end is true on Stripe; access continues until period_end
  subscriptionCancelAtPeriodEnd Boolean   @default(false)
  stripeCustomerId              String?   @unique
  stripeSubscriptionId          String?   @unique

  // Usage tracking — reset by the platform monthly. For MVP we count via a
  // simple "this calendar month" window in code, not a separate model.
  // Lead-engine config (Phase 2)
  // BYO Google Places API key — plaintext for MVP, encrypt before launch
  googlePlacesApiKey String?

  // Phase 9 — operator's own Stripe Secret Key for billing THEIR clients
  // (separate from the platform's Stripe used to charge the operator).
  // BYO; plaintext for MVP, encrypt before launch.
  stripeSecretKey String?

  // BYO OpenAI key for image generation (sk-...). Used to enhance reference
  // photos into polished site assets via gpt-image-1. Cost goes to operator.
  openaiApiKey String?

  // Onboarding wizard completion flag (Phase 7)
  onboardingCompletedAt DateTime?

  users          User[]
  restaurants    Restaurant[]
  leads          Lead[]
  leadSearches   LeadSearch[]
  templates      OutreachTemplate[]
  clientBilling  ClientBilling[]
  clientInvoices ClientInvoice[]

  // Operator's public-facing pitch contact (used as a {{operatorPhone}} merge field)
  pitchPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Outreach templates the operator uses to pitch leads. operatorId=null is a
// platform-default seeded for everyone; operator-owned rows are custom.
// Platform-defaults can't be edited or deleted by operators — they can
// duplicate one (creates a new row with operatorId set) and edit the copy.
model OutreachTemplate {
  id           String   @id @default(cuid())
  operatorId   String?
  operator     Operator? @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  // Short display name in the operator's library
  name         String
  // email | sms | script | voicemail
  kind         String
  // For "email" only; null for the rest
  subject      String?
  // Body with merge fields like {{businessName}} {{city}} {{ownerName}}
  body         String
  // Which business types this template is best suited for (free-form;
  // empty = applies to all)
  appliesTo    String?
  isArchived   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
}

// A LeadSearch is one operator's invocation of the lead-finder (Google
// Places query). It exists so we can dedupe leads + show the operator
// their search history.
model LeadSearch {
  id           String   @id @default(cuid())
  operatorId   String
  operator     Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  // What the operator searched for — used in the UI history
  query        String // free-form e.g. "Boulder, CO"
  businessType String? // e.g. "restaurant", "hvac", "salon"
  // Number of raw places returned vs. saved as leads (after dedupe + filter)
  resultCount  Int      @default(0)
  savedCount   Int      @default(0)
  createdAt    DateTime @default(now())

  leads Lead[]

  @@index([operatorId, createdAt])
}

// A Lead is one prospect surfaced by the lead engine. Owned by an operator;
// scoped queries enforce isolation at the action layer.
model Lead {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  // Where this came from. Null for manually-added leads.
  searchId   String?
  search     LeadSearch? @relation(fields: [searchId], references: [id], onDelete: SetNull)

  // Google Places identifier — unique per operator so re-searching the same
  // area doesn't create duplicates.
  googlePlaceId String?

  // Basic facts about the business
  businessName String
  businessType String?  // free-form / from Places category
  address      String?
  city         String?
  state        String?
  zip          String?
  phone        String?
  websiteUrl   String?  // present means they DO have a site (we filter these out by default)
  rating       Float?
  reviewCount  Int?
  photoUrl     String?
  lat          Float?
  lng          Float?

  // Pipeline status — drives the kanban view
  // new | contacted | qualified | closed_won | closed_lost
  status          String   @default("new")
  notes           String?
  lastContactedAt DateTime?

  // If this lead was converted into a paying client, link the resulting
  // Restaurant row. SetNull on delete so we don't lose the lead history.
  convertedRestaurantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([operatorId, googlePlaceId])
  @@index([operatorId, status])
  @@index([operatorId, createdAt])
}

model Restaurant {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  // Type of business: "restaurant" (default — has menu + online ordering)
  // or "service_business" (salon/gym/spa/contractor — services + contact only)
  type         String  @default("restaurant")
  tagline      String?
  description  String?
  // Marketing copy (often AI-generated)
  heroHeadline String?
  heroSubhead  String?
  aboutCopy    String?
  // JSON array of services for service_business clients:
  //   [{ id, name, description, priceCents?, duration? }, ...]
  services     String?
  // JSON array of FeatureKey strings — drives what's on the public site
  // AND what tabs show in admin. See lib/features.ts. Empty string means
  // "use the type's defaults" (the read helpers handle that).
  enabledFeatures String @default("[]")
  address      String
  city         String?
  state        String?
  zip          String?
  phone        String
  email        String?
  // JSON: { "mon": { "open": "06:00", "close": "14:00", "closed": false, "note": null }, ... }
  hours        String  @default("{}")
  primaryColor String  @default("#C8542C")
  accentColor  String  @default("#2D5A3D")
  logoUrl      String?
  heroImageUrl String?
  // Visual template applied to the public-facing site.
  //   "modern"  — warm/organic (default; what Mama Bears uses)
  //   "classic" — formal/serif, navy + cream
  // Adding a template = drop a directory under components/templates/<id>/
  // and register it in lib/templates.ts.
  templateId   String  @default("modern")
  // Stored as basis-points: 865 = 8.65%
  taxBps       Int     @default(0)
  isActive     Boolean @default(true)
  // Exactly one restaurant may be primary — serves the root path "/"
  isPrimary    Boolean @default(false)

  // Online ordering controls
  isOrderingPaused Boolean @default(false)
  // JSON: same shape as `hours` but for online orders. null = use main `hours`.
  orderingHours    String?
  // bcrypt hash of a 4-digit PIN; null = no PIN, revenue is shown
  revenuePinHash   String?

  // Appointment booking config — JSON:
  //   {
  //     "enabled": true,
  //     "slotMinutes": 30,
  //     "bufferMinutes": 0,
  //     "leadTimeHours": 2,
  //     "maxDaysAhead": 30,
  //     "bookingHours": null  // null = reuse `hours`; or override shape
  //   }
  // Empty string / "{}" means "not yet configured" → fall back to the
  // free-form InquiryForm.
  appointmentConfig String @default("{}")

  // Stripe Connect (Express account)
  stripeAccountId      String?  // acct_xxx
  // "none" | "pending" | "active" | "restricted"
  stripeAccountStatus  String   @default("none")
  stripeChargesEnabled Boolean  @default(false)
  stripePayoutsEnabled Boolean  @default(false)
  // Platform fee in basis points (100 = 1%). Default 0.
  platformFeeBps       Int      @default(0)

  // Operator (paying SaaS user) who owns this client. Null = unowned
  // (legacy / platform-direct). onDelete: SetNull preserves the restaurant
  // if the operator account is removed — super_admin can reassign.
  operatorId String?
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  categories MenuCategory[]
  items      MenuItem[]
  orders     Order[]
  users      User[]
  billing    ClientBilling?
  invoices   ClientInvoice[]
  setupLinks SetupLink[]
  inquiries  Inquiry[]
  staff      Staff[]
  classes    ClassSession[]
  testimonials Testimonial[]
  galleryImages GalleryImage[]
  faqs       Faq[]
  appointments Appointment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
}

// One-time setup link the operator generates to hand the restaurant admin
// off to the end-client. Owner lands on /setup/<token>, sets a password,
// and becomes a restaurant_admin user.
model SetupLink {
  id                  String     @id @default(cuid())
  token               String     @unique
  restaurantId        String
  restaurant          Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  email               String
  name                String?
  expiresAt           DateTime
  usedAt              DateTime?
  createdByOperatorId String

  createdAt DateTime @default(now())

  @@index([restaurantId])
}

// Team members for personal_service / healthcare / fitness / professional
// types. Public site renders a "Meet the team" grid with photos + bios.
// Per-staff bookingUrl deep-links into Booksy/Vagaro/Mindbody/etc.
model Staff {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name        String
  title       String? // "Senior Stylist", "DDS", "Head Coach"
  bio         String? // short paragraph
  photoUrl    String?
  // JSON array of strings — specialties/credentials/services they do
  specialties String  @default("[]")
  // Per-staff booking deep link (Booksy, Vagaro, Mindbody, Square Appointments, etc.)
  bookingUrl  String?
  instagram   String?
  // Years of experience surfaced as a small chip on cards
  yearsExperience Int?

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, displayOrder])
}

// Recurring class sessions for fitness/yoga/CrossFit/dance studios. Each
// row is one weekly slot (e.g. "Mon 6 AM CrossFit with Sarah"); the public
// site renders them as a weekly schedule grid.
model ClassSession {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  name         String   // "CrossFit", "Vinyasa Yoga", "Reformer Pilates"
  description  String?
  // mon|tue|wed|thu|fri|sat|sun
  dayOfWeek    String
  // HH:MM 24h
  startTime    String
  // HH:MM 24h
  endTime      String
  // Optional staff (instructor) reference — stored as id for now, no FK to keep deletes safe
  instructorId String?
  capacity     Int?
  level        String?  // "all-levels", "beginner", "intermediate", "advanced"
  bookingUrl   String?

  isActive     Boolean  @default(true)
  displayOrder Int      @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, dayOfWeek])
}

// Curated customer testimonials. Pulled from Google/Yelp by the operator
// OR scraped from a review site. Manually-marked verified = true means we
// trust it for public display.
model Testimonial {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  quote        String
  author       String? // "Sarah K." — first name + last initial is the public convention
  rating       Int? // 1..5
  source       String  @default("manual") // manual|google|yelp|facebook|tripadvisor
  sourceUrl    String?

  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())
}

// Gallery photo collection — shared across all business types. Optionally
// tagged for filtering (e.g. salon: cuts/color/space; trade: before/after).
model GalleryImage {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  imageUrl     String
  caption      String?
  tag          String? // free-form ("cuts", "color", "after", etc.)
  // For before/after pairs — points to the "before" image's id within the
  // same gallery. The "after" is the primary row.
  pairedBeforeId String?

  displayOrder Int     @default(0)
  isActive     Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([restaurantId, displayOrder])
}

// FAQ entries for SEO + objection-handling on the public site.
model Faq {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  question     String
  answer       String

  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)

  createdAt DateTime @default(now())

  @@index([restaurantId, displayOrder])
}

// Real, slot-reserving appointment bookings (not free-form inquiries).
// Distinct from Inquiry — these have a specific startsAt + endsAt and
// participate in conflict-detection for the public booking widget.
model Appointment {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  // The exact slot reserved (server-side computed from start + service duration)
  startsAt   DateTime
  endsAt     DateTime

  // Service requested (free-form name from services JSON or whatever client typed)
  serviceName String?
  serviceDurationMinutes Int?

  // Optional staff/provider assignment
  staffId String?

  // Customer info
  customerName  String
  customerEmail String?
  customerPhone String?
  notes         String?

  // pending | confirmed | declined | completed | cancelled | no_show
  status     String  @default("pending")
  // Admin notes after the fact
  adminNotes String?

  // Set when the customer (or admin) cancels
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, startsAt])
  @@index([restaurantId, status])
}

// Customer-submitted inquiries from the public site (quote request, contact
// form, appointment request). Restaurant admins see + work them in the
// Inquiries inbox.
model Inquiry {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // "quote" | "contact" | "appointment"
  kind         String

  customerName  String
  customerEmail String?
  customerPhone String?
  message       String?

  // For quote: short description of the job/service requested
  // For appointment: which service they want
  serviceRequested String?

  // For appointment: preferred date/time slots (free text — they're requests, not confirmed bookings)
  preferredDate String?
  preferredTime String?

  // For trade services: where the work is
  address String?

  // new | contacted | quoted | scheduled | closed | spam
  status String  @default("new")
  // Admin-only notes after follow-up
  notes  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
}

// How the operator charges THIS restaurant for the website + services.
// One row per restaurant. Operator chooses one of three modes when they
// hand the site over to the client.
model ClientBilling {
  id           String     @id @default(cuid())
  restaurantId String     @unique
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  operatorId   String
  operator     Operator   @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  // revenue_share | one_time | monthly
  mode String

  amountCents   Int? // one_time and monthly
  percentageBps Int? // revenue_share (e.g. 300 = 3%)

  description String?

  // draft | active | paused | canceled
  status String @default("draft")

  stripeSubscriptionId String? @unique
  stripeCustomerId     String?
  // For monthly mode: the recurring Stripe Price we created for this client.
  // Reused on renewals so we don't accumulate duplicate Products/Prices.
  stripePriceId        String?
  // For monthly mode: the most recent Checkout Session URL we generated so
  // the operator can re-share it with the client until they activate the sub.
  pendingCheckoutUrl   String?

  clientBillingEmail String?
  clientBillingName  String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoices ClientInvoice[]

  @@index([operatorId])
}

// One row per Stripe Invoice the operator has sent the client via their
// own Stripe account (BYO key).
model ClientInvoice {
  id           String        @id @default(cuid())
  billingId    String
  billing      ClientBilling @relation(fields: [billingId], references: [id], onDelete: Cascade)
  restaurantId String
  restaurant   Restaurant    @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  operatorId   String
  operator     Operator      @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  stripeInvoiceId String? @unique
  hostedUrl       String?
  // open | paid | uncollectible | void | draft
  status          String  @default("draft")
  amountCents     Int
  currency        String  @default("usd")
  description     String?
  dueAt           DateTime?
  paidAt          DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId, status])
  @@index([restaurantId])
}

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  displayOrder Int        @default(0)

  items MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id           String       @id @default(cuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  priceCents   Int
  imageUrl     String?
  isAvailable  Boolean      @default(true)
  displayOrder Int          @default(0)

  orderItems OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
}

model Order {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderNumber   Int
  customerName  String
  customerPhone String
  customerEmail String?
  // "pickup" — only pickup for MVP. "dine-in" deferrable.
  orderType     String     @default("pickup")
  // "ASAP" or "HH:MM" or display string set at checkout
  pickupTime    String     @default("ASAP")
  notes         String?
  subtotalCents Int
  taxCents      Int        @default(0)
  tipCents      Int        @default(0)
  totalCents    Int
  // new | preparing | ready | completed | cancelled
  status        String     @default("new")
  // pay_at_pickup | card
  paymentMethod String     @default("pay_at_pickup")
  // pending | paid | refunded | failed
  paymentStatus String     @default("pending")
  // Stripe PaymentIntent id (pi_xxx) for card orders
  stripePaymentIntentId String? @unique
  stripeReceiptUrl      String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
}

model OrderItem {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  // Snapshot fields — preserved even if menu item changes or is deleted
  name       String
  priceCents Int
  quantity   Int
  notes      String?

  @@index([orderId])
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String?
  // super_admin | operator | restaurant_admin
  role         String
  // For restaurant_admin: the restaurant they manage
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // For operator: the operator account this user belongs to
  operatorId   String?
  operator     Operator?   @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([operatorId])
}
