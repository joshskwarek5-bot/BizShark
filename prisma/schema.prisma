generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// An Operator is a paying user of the SaaS — a "would-be agency owner" who
// signed up to find local businesses, build them websites, and pitch them as
// paying clients. Each Operator owns 0..N Restaurants (their clients).
//
// Roles in the system:
//   - super_admin / platform_admin: Josh, the platform owner. Sees everything.
//   - operator: a paying user. Sees only their own clients/leads.
//   - restaurant_admin: an end-client's owner. Sees only their restaurant.
model Operator {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  // The operator's own agency/brand name (e.g. "Acme Web Studio")
  businessName String?

  // Location context — used as the default for lead search radius
  areaCity     String?
  areaState    String?

  // Subscription state (Phase 5 will fill these in)
  // trial | active | past_due | canceled
  subscriptionStatus   String    @default("trial")
  // starter | pro | agency
  subscriptionTier     String    @default("starter")
  trialEndsAt          DateTime?
  stripeCustomerId     String?
  stripeSubscriptionId String?

  // Lead-engine config (Phase 2)
  // BYO Google Places API key — plaintext for MVP, encrypt before launch
  googlePlacesApiKey String?

  users        User[]
  restaurants  Restaurant[]
  leads        Lead[]
  leadSearches LeadSearch[]
  templates    OutreachTemplate[]

  // Operator's public-facing pitch contact (used as a {{operatorPhone}} merge field)
  pitchPhone String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Outreach templates the operator uses to pitch leads. operatorId=null is a
// platform-default seeded for everyone; operator-owned rows are custom.
// Platform-defaults can't be edited or deleted by operators — they can
// duplicate one (creates a new row with operatorId set) and edit the copy.
model OutreachTemplate {
  id           String   @id @default(cuid())
  operatorId   String?
  operator     Operator? @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  // Short display name in the operator's library
  name         String
  // email | sms | script | voicemail
  kind         String
  // For "email" only; null for the rest
  subject      String?
  // Body with merge fields like {{businessName}} {{city}} {{ownerName}}
  body         String
  // Which business types this template is best suited for (free-form;
  // empty = applies to all)
  appliesTo    String?
  isArchived   Boolean  @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
}

// A LeadSearch is one operator's invocation of the lead-finder (Google
// Places query). It exists so we can dedupe leads + show the operator
// their search history.
model LeadSearch {
  id           String   @id @default(cuid())
  operatorId   String
  operator     Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  // What the operator searched for — used in the UI history
  query        String // free-form e.g. "Boulder, CO"
  businessType String? // e.g. "restaurant", "hvac", "salon"
  // Number of raw places returned vs. saved as leads (after dedupe + filter)
  resultCount  Int      @default(0)
  savedCount   Int      @default(0)
  createdAt    DateTime @default(now())

  leads Lead[]

  @@index([operatorId, createdAt])
}

// A Lead is one prospect surfaced by the lead engine. Owned by an operator;
// scoped queries enforce isolation at the action layer.
model Lead {
  id         String   @id @default(cuid())
  operatorId String
  operator   Operator @relation(fields: [operatorId], references: [id], onDelete: Cascade)
  // Where this came from. Null for manually-added leads.
  searchId   String?
  search     LeadSearch? @relation(fields: [searchId], references: [id], onDelete: SetNull)

  // Google Places identifier — unique per operator so re-searching the same
  // area doesn't create duplicates.
  googlePlaceId String?

  // Basic facts about the business
  businessName String
  businessType String?  // free-form / from Places category
  address      String?
  city         String?
  state        String?
  zip          String?
  phone        String?
  websiteUrl   String?  // present means they DO have a site (we filter these out by default)
  rating       Float?
  reviewCount  Int?
  photoUrl     String?
  lat          Float?
  lng          Float?

  // Pipeline status — drives the kanban view
  // new | contacted | qualified | closed_won | closed_lost
  status          String   @default("new")
  notes           String?
  lastContactedAt DateTime?

  // If this lead was converted into a paying client, link the resulting
  // Restaurant row. SetNull on delete so we don't lose the lead history.
  convertedRestaurantId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([operatorId, googlePlaceId])
  @@index([operatorId, status])
  @@index([operatorId, createdAt])
}

model Restaurant {
  id           String  @id @default(cuid())
  slug         String  @unique
  name         String
  // Type of business: "restaurant" (default — has menu + online ordering)
  // or "service_business" (salon/gym/spa/contractor — services + contact only)
  type         String  @default("restaurant")
  tagline      String?
  description  String?
  // Marketing copy (often AI-generated)
  heroHeadline String?
  heroSubhead  String?
  aboutCopy    String?
  // JSON array of services for service_business clients:
  //   [{ id, name, description, priceCents?, duration? }, ...]
  services     String?
  address      String
  city         String?
  state        String?
  zip          String?
  phone        String
  email        String?
  // JSON: { "mon": { "open": "06:00", "close": "14:00", "closed": false, "note": null }, ... }
  hours        String  @default("{}")
  primaryColor String  @default("#C8542C")
  accentColor  String  @default("#2D5A3D")
  logoUrl      String?
  heroImageUrl String?
  // Stored as basis-points: 865 = 8.65%
  taxBps       Int     @default(0)
  isActive     Boolean @default(true)
  // Exactly one restaurant may be primary — serves the root path "/"
  isPrimary    Boolean @default(false)

  // Online ordering controls
  isOrderingPaused Boolean @default(false)
  // JSON: same shape as `hours` but for online orders. null = use main `hours`.
  orderingHours    String?
  // bcrypt hash of a 4-digit PIN; null = no PIN, revenue is shown
  revenuePinHash   String?

  // Stripe Connect (Express account)
  stripeAccountId      String?  // acct_xxx
  // "none" | "pending" | "active" | "restricted"
  stripeAccountStatus  String   @default("none")
  stripeChargesEnabled Boolean  @default(false)
  stripePayoutsEnabled Boolean  @default(false)
  // Platform fee in basis points (100 = 1%). Default 0.
  platformFeeBps       Int      @default(0)

  // Operator (paying SaaS user) who owns this client. Null = unowned
  // (legacy / platform-direct). onDelete: SetNull preserves the restaurant
  // if the operator account is removed — super_admin can reassign.
  operatorId String?
  operator   Operator? @relation(fields: [operatorId], references: [id], onDelete: SetNull)

  categories MenuCategory[]
  items      MenuItem[]
  orders     Order[]
  users      User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([operatorId])
}

model MenuCategory {
  id           String     @id @default(cuid())
  restaurantId String
  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  displayOrder Int        @default(0)

  items MenuItem[]

  @@index([restaurantId])
}

model MenuItem {
  id           String       @id @default(cuid())
  restaurantId String
  restaurant   Restaurant   @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  categoryId   String
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  name         String
  description  String?
  priceCents   Int
  imageUrl     String?
  isAvailable  Boolean      @default(true)
  displayOrder Int          @default(0)

  orderItems OrderItem[]

  @@index([restaurantId])
  @@index([categoryId])
}

model Order {
  id            String     @id @default(cuid())
  restaurantId  String
  restaurant    Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orderNumber   Int
  customerName  String
  customerPhone String
  customerEmail String?
  // "pickup" — only pickup for MVP. "dine-in" deferrable.
  orderType     String     @default("pickup")
  // "ASAP" or "HH:MM" or display string set at checkout
  pickupTime    String     @default("ASAP")
  notes         String?
  subtotalCents Int
  taxCents      Int        @default(0)
  tipCents      Int        @default(0)
  totalCents    Int
  // new | preparing | ready | completed | cancelled
  status        String     @default("new")
  // pay_at_pickup | card
  paymentMethod String     @default("pay_at_pickup")
  // pending | paid | refunded | failed
  paymentStatus String     @default("pending")
  // Stripe PaymentIntent id (pi_xxx) for card orders
  stripePaymentIntentId String? @unique
  stripeReceiptUrl      String?

  items OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([restaurantId, orderNumber])
  @@index([restaurantId, status])
  @@index([restaurantId, createdAt])
}

model OrderItem {
  id         String    @id @default(cuid())
  orderId    String
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  // Snapshot fields — preserved even if menu item changes or is deleted
  name       String
  priceCents Int
  quantity   Int
  notes      String?

  @@index([orderId])
}

model User {
  id           String      @id @default(cuid())
  email        String      @unique
  passwordHash String
  name         String?
  // super_admin | operator | restaurant_admin
  role         String
  // For restaurant_admin: the restaurant they manage
  restaurantId String?
  restaurant   Restaurant? @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  // For operator: the operator account this user belongs to
  operatorId   String?
  operator     Operator?   @relation(fields: [operatorId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([restaurantId])
  @@index([operatorId])
}
