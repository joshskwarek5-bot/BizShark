DATABASE_URL="file:./dev.db"
# At least 32 characters. Used to sign session cookies.
SESSION_SECRET="generate_a_random_32_plus_char_string_here_xxxxx"
NEXT_PUBLIC_APP_NAME="Restaurant Platform"

# Optional: Anthropic API key for AI-generated landing copy on /platform/restaurants/new.
# Without this, the AI assist box on that page shows a disabled state with setup instructions.
# Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY="sk-ant-..."

# Optional: Stripe — required to take card payments online.
# Get test keys at https://dashboard.stripe.com/test/apikeys
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Set after creating a webhook in https://dashboard.stripe.com/test/webhooks
# Endpoint should point to {NEXT_PUBLIC_APP_URL}/api/stripe/webhook
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Optional: base URL the app uses for Stripe redirect URLs and webhooks.
# Falls back to https://$VERCEL_URL in prod, http://localhost:3000 in dev.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"
