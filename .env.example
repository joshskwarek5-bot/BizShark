DATABASE_URL="file:./dev.db"
# At least 32 characters. Used to sign session cookies.
SESSION_SECRET="generate_a_random_32_plus_char_string_here_xxxxx"
NEXT_PUBLIC_APP_NAME="BizShark"

# Optional: Anthropic API key for AI-generated landing copy on /platform/restaurants/new.
# Without this, the AI assist box on that page shows a disabled state with setup instructions.
# Get a key at https://console.anthropic.com/settings/keys
# ANTHROPIC_API_KEY="sk-ant-..."

# Stripe — required to take card payments online.
# Get keys at https://dashboard.stripe.com/apikeys (use sk_test_ for dev)
# STRIPE_SECRET_KEY="sk_test_..."
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_test_..."
# Set after creating a webhook in https://dashboard.stripe.com/webhooks
# Endpoint: {NEXT_PUBLIC_APP_URL}/api/stripe/webhook  (events: all subscription + checkout)
# STRIPE_WEBHOOK_SECRET="whsec_..."

# Stripe SaaS billing plan prices — run `npm run stripe:setup` to create them.
# STRIPE_PRICE_STARTER="price_..."
# STRIPE_PRICE_PRO="price_..."
# STRIPE_PRICE_AGENCY="price_..."

# Base URL for Stripe redirect URLs and webhooks.
# Falls back to https://$VERCEL_URL in prod, http://localhost:3000 in dev.
# NEXT_PUBLIC_APP_URL="https://your-deployment.vercel.app"

# Optional: Resend — sends email receipts to customers after a successful card
# payment. If unset, orders still complete; we just skip the email and log a
# warning. Get a key at https://resend.com/api-keys.
# RESEND_API_KEY="re_..."
# Override the From address (must be on a verified Resend domain).
# Defaults to "BizShark <onboarding@resend.dev>".
# RESEND_FROM="Orders <orders@yourdomain.com>"
